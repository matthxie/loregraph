{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-main.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing main + pruning merged branches…"
          }
        ]
      }
    ]
  }
}
