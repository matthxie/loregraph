# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# With OPENAI_API_KEY set, the "auto" extractor and the answerer use gpt-4o-mini for
# extraction, image vision, and answering. Without it, the default 'cue_gated'
# extractor still runs a keyless local NLP floor, but the live 'haiku'/'auto'
# extractor backend and the answerer are live-only and raise without a key. The
# .env file is gitignored.
OPENAI_API_KEY=sk-...
