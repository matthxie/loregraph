# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# With ANTHROPIC_API_KEY set, the "auto" extractor uses Claude Haiku 4.5 for
# extraction + image vision. Without it, the pipeline falls back to the offline
# heuristic extractor (no key required). The .env file is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
