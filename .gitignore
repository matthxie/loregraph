# macOS
.DS_Store

# Per-developer editor settings (window colors etc. — nothing shared lives here)
.vscode/

# Secrets — real key lives here, never commit it (see .env.example for the template)
.env

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# HF / model caches + the transient LongMemEval download (scripts/build_longmemeval.py)
.cache/

# LongMemEval (dataset/longmemeval/): episode bodies are heavy and regenerable, so only
# the lean questions.jsonl + manifest.json are committed. The tiny `sample` + `micro` tiers
# DO ship their episodes (committed fixtures). Rebuild others: python scripts/build_longmemeval.py
dataset/longmemeval/*/episodes.jsonl
!dataset/longmemeval/sample/episodes.jsonl
!dataset/longmemeval/micro/episodes.jsonl

# Generated graph store
store/
*.db
.pytest_cache/

# Generated HTML viewer
kg_viz.html

# Dashboard test-run artifacts (regenerable via `python -m kg testrun`)
runs/

# Throwaway test virtualenv
.venv-test/
results/

# Packaging build artifacts
*.egg-info/
build/
dist/
